  "value_help": [
    {
      "match": "^companycode$|company code",
      "service": "/sap/opu/odata/sap/API_COMPANYCODE_SRV/A_CompanyCode",
      "key": "CompanyCode",
      "text": "CompanyCodeName"
    },
    {
      "match": "^glaccount$|^account$|g.?l account|general ledger",
      "service": "/sap/opu/odata/sap/API_GLACCOUNTINCHARTOFACCOUNTS_SRV/A_GLAccountInChartOfAccounts",
      "key": "GLAccount",
      "text": "GLAccountName"
    },
    {
      "match": "^costcenter$|cost cent",
      "service": "/sap/opu/odata/sap/API_COSTCENTER_SRV/A_CostCenter",
      "key": "CostCenter",
      "text": "CostCenterName"
    },
    {
      "match": "^profitcenter$|profit cent",
      "service": "/sap/opu/odata/sap/API_PROFITCENTER_SRV/A_ProfitCenter",
      "key": "ProfitCenter",
      "text": "ProfitCenterName"
    },
    {
      "match": "^plant$",
      "service": "/sap/opu/odata/sap/API_PLANT_SRV/A_Plant",
      "key": "Plant",
      "text": "PlantName"
    },
    {
      "match": "^supplier$|^vendor",
      "service": "/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_Supplier",
      "key": "Supplier",
      "text": "SupplierName"
    },
    {
      "match": "^customer$|^payer",
      "service": "/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_Customer",
      "key": "Customer",
      "text": "CustomerName"
    },
    {
      "match": "currency",
      "service": "/sap/opu/odata/sap/API_CURRENCY_SRV/A_Currency",
      "key": "Currency",
      "text": null
    },
    {
      "match": "^material$|material number|^product$",
      "service": "/sap/opu/odata/sap/API_PRODUCT_SRV/A_Product",
      "key": "Product",
      "text": null
    }
  ],
  "thresholds": {
    "match_minimum": 0.35,
    "review_from": 0.5,
    "confident_from": 0.85,
    "learn_from": 0.85,
    "synonym_floor": 0.6
  }
}
